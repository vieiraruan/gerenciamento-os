# Monta a pasta CONTRATOS do Google Drive da empresa em /srv/drive/CONTRATOS (rclone).
# A credencial do Drive fica em /etc/lotus/rclone.conf (remote "drive"), só no servidor.
# Cada pasta não lida é uma chamada ao Google (~1 s): as pastas ficam em memória (dir-cache 1000h) e o
# poll de 15 s traz as mudanças feitas no Drive. Planilhas/Apresentações do Google aparecem como
# "<nome>.link.html" (não como .xlsx exportado, que o Lotus confundiria com planilha de verdade).
[Unit]
Description=Lotus - Google Drive (rclone)
Wants=network-online.target
After=network-online.target
Before=docker.service

[Service]
Type=simple
ExecStartPre=-/bin/fusermount3 -uz /srv/drive/CONTRATOS
ExecStartPre=/bin/mkdir -p /srv/drive/CONTRATOS /var/cache/lotus-rclone
ExecStart=/usr/bin/rclone mount drive:CONTRATOS /srv/drive/CONTRATOS \
  --config /etc/lotus/rclone.conf \
  --allow-other --uid 1000 --gid 1000 --umask 002 \
  --vfs-cache-mode full --vfs-cache-max-size 5G --vfs-cache-max-age 8760h --cache-dir /var/cache/lotus-rclone \
  --dir-cache-time 1000h --poll-interval 15s --vfs-write-back 2s \
  --drive-export-formats docx,link.html --log-level INFO
# o rclone do Ubuntu não avisa o systemd (notify): espera a pasta aparecer montada
ExecStartPost=/bin/sh -c 'for i in $(seq 1 90); do mountpoint -q /srv/drive/CONTRATOS && exit 0; sleep 1; done; exit 1'
# carrega as pastas e os dados do Lotus em segundo plano (aquecer-drive.sh)
ExecStartPost=/bin/sh -c '/opt/lotus/gerenciamento-os/infra/oracle/servidor/aquecer-drive.sh >/dev/null 2>&1 &'
ExecStop=/bin/fusermount3 -uz /srv/drive/CONTRATOS
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
